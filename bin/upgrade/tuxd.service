[Unit]
Description=TuxD Linux MQTT Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/henrik/TuxD

ExecStart=/usr/bin/env python3 /home/henrik/TuxD/start.py

Restart=on-failure
RestartSec=10

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
